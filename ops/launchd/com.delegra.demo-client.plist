<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.delegra.demo-client</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/node</string><string>agent/demo-client.js</string></array>
  <key>WorkingDirectory</key><string>/Users/amithreddy/my-token</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>INTERVAL_HOURS</key><string>2</string>
    <key>PAYMENT</key><string>5</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/amithreddy/my-token/demo-client.log</string>
  <key>StandardErrorPath</key><string>/Users/amithreddy/my-token/demo-client.log</string>
</dict>
</plist>
